 "sentences": [
  {
   "text": "我希望 AI 幫我整理書包",
   "who": "一年級",
   "type": "希望"
  },
  {
   "text": "我希望 AI 陪我玩鬼抓人",
   "who": "二年級",
   "type": "希望"
  },
  {
   "text": "我希望 AI 幫我把字寫漂亮",
   "who": "一年級",
   "type": "希望"
  },
  {
   "text": "我希望 AI 提醒我明天要帶水壺",
   "who": "二年級",
   "type": "希望"
  },
  {
   "text": "我希望 AI 幫我畫一隻會飛的貓",
   "who": "三年級",
   "type": "希望"
  },
  {
   "text": "我希望 AI 教我怎麼跟新同學說話",
   "who": "三年級",
   "type": "希望"
  },
  {
   "text": "我希望 AI 幫我聽懂爸爸講的台語",
   "who": "四年級",
   "type": "希望"
  },
  {
   "text": "我希望 AI 幫我算出要存多久才買得起腳踏車",
   "who": "四年級",
   "type": "希望"
  },
  {
   "text": "我希望 AI 幫我把作文改得像我自己寫的",
   "who": "五年級",
   "type": "希望"
  },
  {
   "text": "我希望 AI 幫奶奶看懂藥袋上的字",
   "who": "五年級",
   "type": "希望"
  },
  {
   "text": "我希望 AI 幫我找到不會讓我睡著的科學影片",
   "who": "六年級",
   "type": "希望"
  },
  {
   "text": "我希望 AI 幫我練習上台不緊張",
   "who": "六年級",
   "type": "希望"
  },
  {
   "text": "AI 幫我唸過故事書",
   "who": "二年級",
   "type": "做過"
  },
  {
   "text": "AI 幫我查過蝸牛吃什麼",
   "who": "三年級",
   "type": "做過"
  },
  {
   "text": "我看過 AI 幫媽媽把英文信翻成中文",
   "who": "四年級",
   "type": "做過"
  },
  {
   "text": "AI 幫我把數學題目再講一次，講到我懂",
   "who": "四年級",
   "type": "做過"
  },
  {
   "text": "AI 幫我做過自然報告的大綱，它比我快很多",
   "who": "六年級",
   "type": "做過"
  },
  {
   "text": "AI 幫我想過班遊要玩什麼遊戲",
   "who": "五年級",
   "type": "做過"
  },
  {
   "text": "AI 幫我畫過海報草稿，但顏色是我自己選的",
   "who": "五年級",
   "type": "做過"
  },
  {
   "text": "AI 幫我把英文單字編成一首歌",
   "who": "六年級",
   "type": "做過"
  },
  {
   "text": "AI 幫我查過颱風為什麼會轉",
   "who": "三年級",
   "type": "做過"
  },
  {
   "text": "AI 幫我寫過給轉學同學的卡片，我又改了三次",
   "who": "六年級",
   "type": "做過"
  },
  {
   "text": "AI 幫我把一篇課文改成三種難度，讓我有更多時間陪讀得比較慢的孩子",
   "who": "老師",
   "type": "大人"
  },
  {
   "text": "AI 幫我們家看懂孩子的數學題",
   "who": "家長",
   "type": "大人"
  },
  {
   "text": "AI 幫我把班上三十份日記整理出大家最近在煩惱什麼",
   "who": "老師",
   "type": "大人"
  },
  {
   "text": "AI 幫我把聯絡簿翻成越南文給阿嬤看",
   "who": "家長",
   "type": "大人"
  },
  {
   "text": "AI 幫我想了五個讓孩子開口討論的問題，我留下兩個",
   "who": "老師",
   "type": "大人"
  },
  {
   "text": "AI 幫我回答孩子問的「為什麼天空是藍的」，然後我們一起去查",
   "who": "家長",
   "type": "大人"
  },
  {
   "text": "AI 幫我把上課錄音變成重點，讓請假的孩子跟得上",
   "who": "老師",
   "type": "大人"
  },
  {
   "text": "AI 幫我在孩子睡前編了一個關於大同國小的故事",
   "who": "家長",
   "type": "大人"
  }
 ],
